{
	"compilerOptions": {
		"declaration": true,
		"esModuleInterop": true,
		"module": "esnext",
		"moduleResolution": "bundler",
		"outDir": "./dist",
		"skipLibCheck": true,
		"strict": true,
		"strictNullChecks": true,
		"target": "esnext",
		"types": ["vitest/globals", "node"],
		"lib": ["ES2020", "DOM", "DOM.Iterable"]
	},
	"include": ["src"],
	"exclude": ["node_modules", "src/tests"]
}
