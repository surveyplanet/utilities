{
	"compilerOptions": {
		"declaration": true,
		"esModuleInterop": true,
		"outDir": "./dist",
		"skipLibCheck": true,
		"strict": true,
		"strictNullChecks": true,
		"module": "nodenext",
		"moduleResolution": "nodenext",
		"target": "esnext",
		"types": ["vitest/globals", "node"],
		"lib": ["ES2020", "DOM", "DOM.Iterable"],
	},
	"include": ["src"],
	"exclude": ["node_modules", "src/tests"],
}
