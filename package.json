		"./estimate_question_length": "./dist/estimate_question_length.js",
		"./estimate_sample_size": "./dist/estimate_sample_size.js",
		"./get": "./dist/get.js",
		"./has_local_storage": "./dist/has_local_storage.js",
		"./humanize_date": "./dist/humanize_date.js",
		"./in_browser": "./dist/in_browser.js",
		"./in_jsdom": "./dist/in_jsdom.js",
		"./in_node": "./dist/in_node.js",
		"./in_worker": "./dist/in_worker.js",
		"./insert": "./dist/insert.js",
		"./is_date": "./dist/is_date.js",
		"./is_plain_object": "./dist/is_plain_object.js",
		"./locals": "./dist/locals.js",
		"./omit_props": "./dist/omit_props.js",
		"./once": "./dist/once.js",
		"./ordinal_suffix": "./dist/ordinal_suffix.js",
		"./parse_date": "./dist/parse_date.js",
		"./parse_duration": "./dist/parse_duration.js",
		"./range": "./dist/range.js",
		"./scroll_into_view_if_needed": "./dist/scroll_into_view_if_needed.js",
		"./session": "./dist/session.js",
		"./smart_sort": "./dist/smart_sort.js",
		"./string_to_date": "./dist/string_to_date.js",
		"./throttle": "./dist/throttle.js",
		"./titleize": "./dist/titleize.js",
		"./transform_image": "./dist/transform_image.js",
		"./truncate": "./dist/truncate.js",
		"./unique_id": "./dist/unique_id.js",
		"./validate": "./dist/validate.js",
		"./to_boolean": "./dist/to_boolean.js",
		"./log": "./dist/log.js"
	},
	"scripts": {
		"build": "rm -rf dist && tsc",
		"check": "./bin/preflight.sh",
		"clean": "rm -rf dist coverage",
		"format": "prettier \"src/**/*.ts\" --check",
		"format:fix": "prettier \"src/**/*.ts\" --write",
		"lint": "eslint src",
		"release": "semantic-release",
		"release:dry": "semantic-release --dry-run",
		"spell": "cspell .",
		"test": "vitest",
		"test:coverage": "vitest run --coverage",
		"type": "tsc --noEmit",
		"type:dts": "tsc --emitDeclarationOnly"
	},
	"prettier": "@surveyplanet/lint-config/prettier",
	"peerDependencies": {
		"throttle-debounce": "^5.0.0"
	},
	"peerDependenciesMeta": {
		"throttle-debounce": {
			"optional": true
		}
	},
	"devDependencies": {
		"@eslint/js": "^10.0.1",
		"@semantic-release/commit-analyzer": "^13.0.1",
		"@semantic-release/github": "^12.0.8",
		"@semantic-release/npm": "^13.1.5",
		"@surveyplanet/fixtures": "^1.0.1",
		"@surveyplanet/lint-config": "^1.1.2",
		"@surveyplanet/types": "1.0.1-alpha.1",
		"@types/jsdom": "^28.0.3",
		"@types/node": "^25.9.2",
		"@types/throttle-debounce": "^5.0.2",
		"@typescript-eslint/parser": "^8.61.0",
		"@vitest/coverage-v8": "^4.1.8",
		"cspell": "^10.0.1",
		"eslint": "^10.4.1",
		"eslint-config-prettier": "^10.1.8",
		"globals": "^17.6.0",
		"jsdom": "^29.1.1",
		"prettier": "^3.8.4",
		"semantic-release": "^25.0.5",
		"throttle-debounce": "^5.0.2",
		"typescript": "^5.9.3",
		"typescript-eslint": "^8.61.0",
		"vitest": "^4.1.8"
	},
	"dependencies": {
		"pino": "^10.3.1"
	}
}
