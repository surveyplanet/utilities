{
	"name": "@surveyplanet/utilities",
	"version": "0.0.0",
	"license": "UNLICENSED",
	"homepage": "https://github.com/surveyplanet/utilities",
	"type": "module",
	"main": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"repository": {
		"type": "git",
		"url": "git@github.com:surveyplanet/utilities.git"
	},
	"engines": {
		"node": ">= 18",
		"npm": ">= 8"
	},
	"files": [
		"dist"
	],
	"scripts": {
		"build": "rm -rf dist && tsc",
		"check": "./bin/preflight.sh",
		"clean": "rm -rf dist coverage",
		"format": "prettier \"src/**/*.ts\" --check",
		"format:fix": "prettier \"src/**/*.ts\" --write",
		"lint": "eslint src",
		"release": "semantic-release",
		"release:dry": "semantic-release --dry-run",
		"spell": "cspell \"{README.md,.github/*.md,src/**/*.ts}\"",
		"test": "vitest run",
		"test:coverage": "vitest run --coverage",
		"test:watch": "vitest watch",
		"type": "tsc --noEmit",
		"type:dts": "tsc --emitDeclarationOnly"
	},
	"devDependencies": {
		"@semantic-release/commit-analyzer": "^13.0.1",
		"@semantic-release/github": "^12.0.2",
		"@semantic-release/npm": "^13.1.3",
		"@surveyplanet/publish": "^2.0.0-beta.1",
		"@surveyplanet/types": "1.0.0-alpha.89",
		"@types/jsdom": "^27.0.0",
		"@types/node": "^25.0.9",
		"@types/prompts": "^2.4.9",
		"@types/throttle-debounce": "^5.0.2",
		"@typescript-eslint/eslint-plugin": "^8.53.1",
		"@typescript-eslint/parser": "^8.53.1",
		"@vitest/coverage-v8": "^4.0.17",
		"cspell": "^9.6.0",
		"eslint": "^9.39.2",
		"eslint-config-prettier": "^10.1.8",
		"eslint-import-resolver-typescript": "^4.4.4",
		"eslint-plugin-eslint-comments": "^3.2.0",
		"eslint-plugin-import": "^2.32.0",
		"jsdom": "^27.4.0",
		"prettier": "^3.8.1",
		"semantic-release": "^25.0.2",
		"typescript": "^5.9.3",
		"typescript-eslint": "^8.53.1",
		"vitest": "^4.0.17"
	},
	"overrides": {},
	"dependencies": {
		"throttle-debounce": "^5.0.2"
	}
}
